# Authentication
GITHUB_TOKEN=github_pat_xxx
GITHUB_API_BASE=https://api.github.com
GITHUB_API_VERSION=2022-11-28
GITHUB_USER_AGENT="GitHub Flow MCP"

# Defaults
GITHUB_DEFAULT_OWNER=your-github-user-or-org
GITHUB_INITIALS=tc
GITHUB_DEFAULT_BASE_BRANCH=main
GITHUB_LOCAL_REPOS_ROOT=~/Projects

# Safety
GITHUB_WRITE_ENABLED=false
GITHUB_CONFIRMATION_TTL_SECONDS=300
GITHUB_BASECAMP_REQUIRED=false

# Optional workflow policy
GITHUB_PROD_MARKER=production
GITHUB_REVIEW_BY_AI_REPOS=
GITHUB_REVIEW_BY_AI_LABEL=ReviewByAI
GITHUB_BOT_REVIEWER=
